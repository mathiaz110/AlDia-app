# ═══════════════════════════════════════════════════
#  ALDIA APP — Variables de entorno
#  Copiar como .env y completar con valores reales
#  NUNCA subir .env a Git
# ═══════════════════════════════════════════════════

# ─── SERVIDOR ────────────────────────────────────────
PORT=3000
NODE_ENV=production

# CORS — dominios autorizados (separar con coma)
# Ejemplo: https://aldia-app.web.app,https://tudominio.com
ALLOWED_ORIGINS=https://tu-proyecto.web.app

# ─── CLOUDFLARE R2 ───────────────────────────────────
# Dónde obtenerlas:
# 1. cloudflare.com → R2 → Manage R2 API Tokens
# 2. Crear token con permisos Object Read & Write

CF_ACCOUNT_ID=tu_account_id_de_cloudflare
R2_ACCESS_KEY_ID=tu_r2_access_key
R2_SECRET_ACCESS_KEY=tu_r2_secret_key
R2_BUCKET_NAME=aldia-boletas

# URL pública del bucket (opcional pero recomendado)
# Si conectás un dominio propio en R2 → configura aquí
# Si lo dejás vacío → se usan URLs firmadas temporales (7 días)
R2_PUBLIC_URL=https://boletas.tudominio.com

# ─── TWILIO — SMS (opcional para producción) ─────────
# Dónde obtenerlas: twilio.com → Console Dashboard
# Plan gratuito: $15 de crédito inicial
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+5491100000000

# ─── NOTAS DE CONFIGURACIÓN ──────────────────────────
# Firebase: la clave va en firebase-key.json (no acá)
# Railway:  configurar estas variables en el dashboard
# Render:   configurar en Environment Variables
